# Sao chép thành .env rồi điền giá trị:  cp .env.example .env
# Khi chạy bằng Docker Compose, các biến kết nối DB (DATABASE_URL...)
# đã được docker-compose.yml đặt và GHI ĐÈ giá trị trong file này. Email (SMTP_*) lấy từ file này.

NODE_ENV=development
PORT=8000

DATABASE_URL=postgres://bookstore:bookstore@localhost:5432/bookstore
DATABASE_URL_TEST=postgres://bookstore:bookstore@localhost:5432/bookstore_test

CLIENT_URL=http://localhost:3000

# ---------- Xác thực (M01) ----------
# Chuỗi ngẫu nhiên ≥ 32 ký tự. Tạo nhanh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access token (JWT) — phút
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token — ngày
REFRESH_TOKEN_TTL_DAYS=30
# Thời gian gia hạn khi nhiều tab cùng refresh — giây (0 = tắt)
REFRESH_REUSE_GRACE_SECONDS=5
# Token đặt lại mật khẩu — phút
PASSWORD_RESET_TTL_MINUTES=30
# Độ khó băm mật khẩu bcrypt (10–12 là hợp lý)
BCRYPT_SALT_ROUNDS=10

# OTP đăng ký (M01-F01)
REGISTER_OTP_TTL_MINUTES=10
REGISTER_OTP_MAX_ATTEMPTS=5
REGISTER_OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Giới hạn số request theo IP (chống dò mật khẩu / spam) ----------
# false = tắt toàn bộ (tiện khi dev / test thủ công). Luôn để true khi deploy.
RATE_LIMIT_ENABLED=false
# Đăng nhập (chỉ đếm lần sai)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
# Đăng ký
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60
# Nhập OTP đăng ký (chỉ đếm lần sai)
RATE_LIMIT_REGISTER_VERIFY_MAX=20
RATE_LIMIT_REGISTER_VERIFY_WINDOW_MINUTES=15
# Gửi lại OTP
RATE_LIMIT_REGISTER_RESEND_MAX=5
RATE_LIMIT_REGISTER_RESEND_WINDOW_MINUTES=60
# Quên mật khẩu
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MINUTES=60
# Đặt lại mật khẩu
RATE_LIMIT_RESET_PASSWORD_MAX=10
RATE_LIMIT_RESET_PASSWORD_WINDOW_MINUTES=15
# Làm mới token
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_MINUTES=15
# Đổi mật khẩu (chỉ đếm lần sai)
RATE_LIMIT_CHANGE_PASSWORD_MAX=10
RATE_LIMIT_CHANGE_PASSWORD_WINDOW_MINUTES=15

# ---------- Admin mặc định ----------
# Khi server khởi động: DB chưa có tài khoản ADMIN nào → tạo Admin với thông tin dưới đây.
# Đã có Admin thì bỏ qua (không ghi đè mật khẩu). Bỏ trống = không tạo.
# Mật khẩu: 8–72 ký tự, có chữ cái và chữ số. ĐỔI mật khẩu này khi deploy.
ADMIN_EMAIL=admin@bookstore.vn
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Quản trị viên

# ---------- Email ----------
# Chọn 1 trong 2 khối. Đổi xong: docker compose up -d server (restart không đọc lại .env)
# --- Mailpit (mặc định): mail không ra Internet, xem tại http://localhost:8025 ---
# SMTP_HOST: mailpit (chạy bằng Docker) · localhost (chạy server ngoài Docker)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BookStore <no-reply@bookstore.local>

# --- Gmail thật: bỏ # khối này, thêm # vào khối Mailpit ở trên ---
# SMTP_PASS = App Password 16 ký tự, viết liền
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=BookStore <email-cua-ban@gmail.com>

# ---------- Sách & tồn kho (F03) ----------
# Tồn kho <= số này → "sắp hết hàng"
LOW_STOCK_THRESHOLD=5

# ---------- Trang chủ Dark Fantasy (docs/06-ui-ux/shop/01-trang-chu.md mục 4) ----------
# Sách tạo trong vòng số ngày này → tem "Mới" trên thẻ sách
NEW_BOOK_DAYS=30
# Khối "Truyền thuyết": chỉ chọn sách có ít nhất số đánh giá này (thiếu thì bù sách bán chạy)
FEATURED_MIN_REVIEWS=8
# GET /api/home giữ kết quả trong bộ nhớ bao nhiêu giây (0 = không cache)
HOME_CACHE_TTL_SECONDS=60

